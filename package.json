{
  "name": "express-auth-drizzle",
  "version": "1.0.0",
  "author": "Ruslan Hamzin",
  "description": "Node.js auth API template using Express.js and Drizzle ORM",
  "license": "MIT",
  "scripts": {
    "dev": "tsx --env-file=.env --watch ./src/main.ts",
    "dev:pretty": "pnpm dev | pino-pretty",
    "type:check": "tsc --noEmit --watch",
    "start:prod": "node dist/main.js",
    "clean": "rimraf ./dist",
    "build": "pnpm clean && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.json",
    "build:prod": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.json",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "db:generate": " pnpm drizzle-kit generate",
    "db:migrate": "pnpm drizzle-kit pull"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "prettier": "3.9.8",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.9.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
